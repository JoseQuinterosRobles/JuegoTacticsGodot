; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="novelaTactics"
run/main_scene="uid://d8ll2eln05ro"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
Autoload="*uid://blcutuc8m6i86"
Calendario="*uid://d1p103t76m8df"
Fade="*uid://bhayv6tylklt6"
Utiles="*uid://g1om6jqpay31"

[dialogue_manager]

runtime/balloon_path="res://dialogues/balloon.tscn"

[display]

window/size/viewport_width=800
window/size/viewport_height=450
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogues/encuesta.dialogue", "res://dialogues/casa_intro.dialogue", "res://dialogues/samir.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

